<script>
// === CONFIG ===
var params = new URLSearchParams(window.location.search);
var stationId = params.get('id') || '5-03';
document.getElementById('station-label').textContent = 'Station ' + stationId;
document.getElementById('confirm-station').textContent = 'Station ' + stationId;

// === LANGUAGE ===
var currentLang = 'en';

function setLang(lang) {
    currentLang = lang;
    document.getElementById('btn-en').classList.toggle('active', lang === 'en');
    document.getElementById('btn-es').classList.toggle('active', lang === 'es');
    document.querySelectorAll('[data-' + lang + ']').forEach(function(el) {
        var text = el.getAttribute('data-' + lang);
        if (text) el.innerHTML = text;
    });
    document.getElementById('header-subtitle').textContent =
        lang === 'en' ? 'Tap your issue below — help is on the way' : 'Toca tu problema abajo — la ayuda está en camino';
}

// === NAVIGATION ===
var pendingIssueEn = '';
var pendingIssueEs = '';

function showScreen(name) {
    document.querySelectorAll('.menu-screen').forEach(function(s) { s.classList.remove('active'); });
    document.getElementById('screen-' + name).classList.add('active');
}

function showSub(cat) { showScreen(cat); }
function goBack() { showScreen('main'); }
function goHome() { showScreen('main'); }

function confirmIssue(issueEn, issueEs) {
    pendingIssueEn = issueEn;
    pendingIssueEs = issueEs;
    document.getElementById('confirm-issue-text').textContent = currentLang === 'es' ? issueEs : issueEn;
    showScreen('confirm');
}

function confirmDirect(issueEn, issueEs) {
    confirmIssue('🔄 ' + issueEn, '🔄 ' + issueEs);
}

// === SUBMIT ===
function submitTicket() {
    var btn = document.getElementById('submit-btn');
    btn.disabled = true;
    btn.textContent = '⏳ Sending...';

    fetch('/api/tickets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            station: 'Station ' + stationId,
            issue: pendingIssueEn
        })
    })
    .then(function(res) { return res.json(); })
    .then(function(data) {
        btn.disabled = false;
        btn.innerHTML = '<span data-en="🚨 Submit Ticket" data-es="🚨 Enviar Ticket">🚨 Submit Ticket</span>';
        showScreen('success');
    })
    .catch(function(err) {
        btn.disabled = false;
        btn.innerHTML = '<span data-en="🚨 Submit Ticket" data-es="🚨 Enviar Ticket">🚨 Submit Ticket</span>';
        showScreen('success');
    });
}
</script>
